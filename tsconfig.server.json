{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "allowJs": false,
    "outDir": "dist-server",
    "rootDir": ".",
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "exclude": ["server/**/*.test.ts"],
  "include": ["server/**/*.ts", "db/schema.ts"]
}
