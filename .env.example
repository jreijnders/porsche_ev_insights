# Copy to .env and fill in. .env is gitignored — it holds real secrets.

# --- Database -------------------------------------------------------------
# Required. No default: compose refuses to start without it.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=ledger
POSTGRES_DB=ledger

# Used when running the server outside Docker (npm run dev:server).
# Inside Docker, compose builds this from the values above.
DATABASE_URL=postgres://ledger:change-me@localhost:5432/ledger
# Host-side Postgres port. Bound to 127.0.0.1 only — needed for dev:full,
# never exposed to the LAN.
POSTGRES_PORT=5432

# --- App ------------------------------------------------------------------
# Host port the dashboard is served on. Keep this on your LAN/VPN only —
# there is no authentication, and the Porsche refresh token lives behind it.
APP_PORT=3001

# Position harvester cadence in minutes. 15 is deliberate: a stop shorter
# than the interval may be missed, and stops under 15 min are not
# destinations anyway (see the merge rule).
POLL_INTERVAL_MINUTES=15

# --- Porsche Connect ------------------------------------------------------
# Credentials are entered through the UI, not here — login needs a captcha
# solved by hand, and the resulting refresh token is stored in Postgres.

# --- Google Maps Platform -------------------------------------------------
# Not needed yet. Only place_id is ever persisted; Google names and
# addresses are not cached (EEA terms).
# GOOGLE_MAPS_API_KEY=
